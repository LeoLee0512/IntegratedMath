      },
      "checks": [
        {
          "request_id": "mathlib_group_defs",
          "location": "Mathlib/Algebra/Group/Defs.lean，行586–619",
          "locator": "Monoid.npow_zero / npow_succ / pow_zero / pow_succ",
          "browse_url": "https://github.com/leanprover-community/mathlib4/blob/v4.24.0/Mathlib/Algebra/Group/Defs.lean#L586",
          "finding": "自然数幂的零次值为1，对每个底数成立，含带零的乘法结构中的0；后继由右乘底数给出。该约定是离散幂，不是除法或极限规则。"
        },
        {
          "request_id": "mathlib_group_defs",
          "location": "Mathlib/Algebra/Group/Defs.lean，行650–667",
          "locator": "one_pow / pow_add / pow_mul",
          "browse_url": "https://github.com/leanprover-community/mathlib4/blob/v4.24.0/Mathlib/Algebra/Group/Defs.lean#L650",
          "finding": "幺半群背景即可对自然数指数归纳证明；pow_add与pow_mul写出零分支及后继分支，无非零底数假设。"
        },
        {
          "request_id": "mathlib_group_basic",
          "location": "Mathlib/Algebra/Group/Basic.lean，行204–214",
          "locator": "CommMonoid / mul_pow",
          "browse_url": "https://github.com/leanprover-community/mathlib4/blob/v4.24.0/Mathlib/Algebra/Group/Basic.lean#L204",
          "finding": "乘积幂要求可交换乘法背景。书稿的Q已具备，但不能把来源条件删去后推广。"
        },
        {
          "request_id": "mathlib_finsum_defs",
          "location": "Mathlib/Algebra/BigOperators/Group/Finset/Defs.lean，行19–25",
          "locator": "Finset求和的AddCommMonoid背景",
          "browse_url": "https://github.com/leanprover-community/mathlib4/blob/v4.24.0/Mathlib/Algebra/BigOperators/Group/Finset/Defs.lean#L19",
          "finding": "有限集合求和预先使用可交换加法结构；不等于本书未经定义的任意求和符号。书稿先定义有序前缀和，再证明要用的有限性质。"
        },
        {
          "request_id": "mathlib_finsum_defs",
