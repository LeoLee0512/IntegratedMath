      "checks": [
        {
          "request_id": "openstax_products",
          "location": "modules/m81384/index.cnxml，行51–65",
          "locator": "m81384，fs-id1167835595382，Exponential Notation",
          "browse_url": "https://github.com/openstax/osbooks-prealgebra-bundle/blob/ad40c7e3c9a909cde81a24c526f52fe26a51fb14/modules/m81384/index.cnxml#L51",
          "finding": "按重复乘法介绍指数；本书须递归定义所有n∈N含0，而不能由正次数的省略号自动推出零次数。"
        },
        {
          "request_id": "openstax_products",
          "location": "modules/m81384/index.cnxml，行94–100",
          "locator": "m81384，Product Property for Exponents",
          "browse_url": "https://github.com/openstax/osbooks-prealgebra-bundle/blob/ad40c7e3c9a909cde81a24c526f52fe26a51fb14/modules/m81384/index.cnxml#L94",
          "finding": "同底乘法合并指数的代数形式。源涉及更广的实底数/整数指数语境；本批仅Q底数和非负整数指数，用归纳证明。"
        },
        {
          "request_id": "openstax_products",
          "location": "modules/m81384/index.cnxml，行401–412",
          "locator": "m81384，fs-id1167826869964 / fs-id1167831969999",
          "browse_url": "https://github.com/openstax/osbooks-prealgebra-bundle/blob/ad40c7e3c9a909cde81a24c526f52fe26a51fb14/modules/m81384/index.cnxml#L401",
          "finding": "零指数条款明确只限非零底数，教材声明被取零次幂的变量非零。它不为本书0^0=1约定提供依据；本书由离散递归单独明确规定，且不据此允许0/0。"
        },
        {
          "request_id": "openstax_products",
          "location": "modules/m81384/index.cnxml，行860–865",
          "locator": "m81384，fs-id1167830898684",
          "browse_url": "https://github.com/openstax/osbooks-prealgebra-bundle/blob/ad40c7e3c9a909cde81a24c526f52fe26a51fb14/modules/m81384/index.cnxml#L860",
          "finding": "幂的幂合并指数。框中写实底数和整数指数，未逐项重述负指数非零条件；本书不照搬扩大范围，本批只n,m∈N。"
        },
        {
          "request_id": "openstax_products",
          "location": "modules/m81384/index.cnxml，行991–997",
          "locator": "m81384，fs-id1167826996996",
          "browse_url": "https://github.com/openstax/osbooks-prealgebra-bundle/blob/ad40c7e3c9a909cde81a24c526f52fe26a51fb14/modules/m81384/index.cnxml#L991",
          "finding": "乘积的非负整数幂逐因子取幂；本书归纳时明确用有理乘法交换结合，不暗示任意非交换对象同样成立。"
        }
      ]
    },
